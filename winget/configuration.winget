# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# GENERATED by `uv run scripts/stack.py build` from scripts/stacklib/winget_build.py. Edit that list, not this file.
# Apply: winget configure --file winget\configuration.winget --accept-configuration-agreements
# Not covered here: the NVIDIA driver, Python (fetched by uv), uv tools and Keycloak (stack.py setup).
properties:
  configurationVersion: 0.2.0
  resources:
  - resource: Microsoft.WinGet.DSC/WinGetPackage
    id: uv
    directives:
      description: 'uv: Python, project environment and uv tools'
      allowPrerelease: false
    settings:
      id: astral-sh.uv
      source: winget
  - resource: Microsoft.WinGet.DSC/WinGetPackage
    id: git
    directives:
      description: Git
      allowPrerelease: false
      securityContext: elevated
    settings:
      id: Git.Git
      source: winget
  - resource: Microsoft.WinGet.DSC/WinGetPackage
    id: ollama
    directives:
      description: Ollama (local models on the GPU)
      allowPrerelease: false
    settings:
      id: Ollama.Ollama
      source: winget
  - resource: Microsoft.WinGet.DSC/WinGetPackage
    id: postgresql
    directives:
      description: PostgreSQL 17 (LiteLLM request log, privacy-gate audit)
      allowPrerelease: false
      securityContext: elevated
    settings:
      id: PostgreSQL.PostgreSQL.17
      source: winget
  - resource: Microsoft.WinGet.DSC/WinGetPackage
    id: ffmpeg
    directives:
      description: ffmpeg (video frames for the privacy gate)
      allowPrerelease: false
    settings:
      id: Gyan.FFmpeg
      source: winget
  - resource: Microsoft.WinGet.DSC/WinGetPackage
    id: tesseract
    directives:
      description: Tesseract OCR (Presidio Image Redactor)
      allowPrerelease: false
      securityContext: elevated
    settings:
      id: UB-Mannheim.TesseractOCR
      source: winget
  - resource: Microsoft.WinGet.DSC/WinGetPackage
    id: exiftool
    directives:
      description: ExifTool (image, video and PDF metadata stripping)
      allowPrerelease: false
    settings:
      id: OliverBetz.ExifTool
      source: winget
  - resource: Microsoft.WinGet.DSC/WinGetPackage
    id: qpdf
    directives:
      description: qpdf (drops old PDF revisions after metadata edits)
      allowPrerelease: false
      securityContext: elevated
    settings:
      id: QPDF.QPDF
      source: winget
