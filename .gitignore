# Secrets and per-machine local settings
.env
.env.*
!.env.example
infrastructure/.env
.claude/settings.local.json

# Runtime state (pids, logs, Phoenix/Open WebUI data, orchestrator job store)
.run/
orchestrator/data/

# Raw traces are machine-local; only retro/reports/*.md summaries are committed
traces/*
!traces/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Node (promptfoo cache when run via npx)
node_modules/
.promptfoo/

# Editors / OS
.vscode/settings.json
.vscode/launch.json
.DS_Store
Thumbs.db
*.swp

# Legacy
.deep-architect/
