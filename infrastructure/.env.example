# =============================================================================
# Anthropic Cloud API
# =============================================================================
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# =============================================================================
# Open WebUI
# =============================================================================
# Generate a strong random string: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=change-me-in-production

# =============================================================================
# Router settings
# =============================================================================
ROUTER_LOG_LEVEL=INFO

# =============================================================================
# Local model assignments
# =============================================================================
# Primary workhorse for coding tasks — requires ~8GB VRAM
LOCAL_MODEL_PRIMARY=qwen2.5-coder:14b

# Lightweight model for simple/fast tasks — requires ~4GB VRAM
LOCAL_MODEL_FAST=qwen2.5-coder:7b

# Reasoning-focused model for code review — requires ~8GB VRAM
LOCAL_MODEL_REASONING=deepseek-r1:14b

# =============================================================================
# Cloud model assignments
# =============================================================================
# Balanced performance / cost for most cloud-routed tasks
CLOUD_MODEL_BALANCED=claude-sonnet-4-6

# Maximum intelligence for security reviews and complex architecture
CLOUD_MODEL_HEAVY=claude-opus-4-8

# =============================================================================
# Routing thresholds
# =============================================================================
# Estimated token count (len(text)//4) above which a request is sent to cloud.
# Raise this number to keep more work local; lower it to bias toward cloud.
COMPLEXITY_TOKEN_THRESHOLD=800

# =============================================================================
# Service URLs (override only if running services on non-default ports)
# =============================================================================
OLLAMA_BASE_URL=http://ollama:11434
