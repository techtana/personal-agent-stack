# Copy to ../.env (repo root) or let `uv run scripts/stack.py setup` generate it.
LITELLM_MASTER_KEY=sk-change-me            # clients authenticate to the gateway with this (Open WebUI, OpenCode, claude-local)
ORCHESTRATOR_BEARER=change-me              # bearer for the MCP server; name deliberately avoids *_TOKEN/*_API_KEY
WEBUI_SECRET_KEY=change-me                 # Open WebUI session signing
ANTHROPIC_API_KEY=                         # optional: enables cloud tiers (Haiku/Sonnet/Opus 5.5) through the gateway
